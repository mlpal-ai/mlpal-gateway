# MLPal Gateway — self-hosted (OSS). Copy to `.env`, set at least one key.
# docker-compose forwards this whole file to the gateway (env_file), so every
# MLPAL_* setting documented in docs/BACKENDS.md works from here.

# ── Provider keys (adapters light up per key present) ────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── AWS Bedrock (open-weight models; needs AWS credentials) ─────────────────
# MLPAL_ENABLE_BEDROCK=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MLPAL_AWS_REGION=us-east-2

# ── Multi-cloud serving backends (docs/BACKENDS.md) ─────────────────────────
# Priority per family; first configured backend that serves the model wins.
# MLPAL_OPENAI_BACKENDS=azure,first_party
# MLPAL_ANTHROPIC_BACKENDS=bedrock,first_party
# MLPAL_GOOGLE_BACKENDS=vertex,first_party
# Same-model retry on the next backend on a serving fault (default on).
# MLPAL_BACKEND_FAILOVER=true
# MLPAL_AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com
# MLPAL_AZURE_OPENAI_API_KEY=
# MLPAL_AZURE_DEPLOYMENTS={"gpt-5-mini": "gpt-5-mini"}
# MLPAL_AZURE_ANTHROPIC_DEPLOYMENTS={"claude-haiku-4-5-20251001": "claude-haiku-4-5-20251001"}
# MLPAL_VERTEX_PROJECT=
# MLPAL_VERTEX_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json   # mount it into the container too
# MLPAL_BEDROCK_ANTHROPIC_MODELS={}   # generate with scripts/probe_backends.py bedrock
# MLPAL_BEDROCK_MANTLE_MODELS=[]

# ── Catalog feed (Models page → Subscribe, or set here) ─────────────────────
# hosted mode ALSO needs a free mlpal.ai key, set via the console Models page
# or PUT /admin/v1/catalog/feed — the env var alone is not enough.
# MLPAL_CATALOG_FEED=hosted

# ── Operations ──────────────────────────────────────────────────────────────
# MLPAL_LOG_LEVEL=INFO
# MLPAL_CAPTURE_PAYLOADS=false        # payload capture (default ON in OSS)
# MLPAL_CU_TO_USD=10.0                # 1 CU = $10 of provider list price
# MLPAL_BUDGET_TIMEZONE=UTC
# ALLOWED_HOSTS=["https://console.example.com"]   # tighten before exposing
# MLPAL_DEBUG=false                   # disables /docs (Swagger)
# TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
